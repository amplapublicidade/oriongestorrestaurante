# Dockerfile específico para deploy no Render
FROM node:18-alpine

# Criar diretório da aplicação
WORKDIR /app

# Copiar package.json e package-lock.json
COPY package*.json ./

# Instalar dependências
RUN npm ci --only=production

# Copiar código fonte
COPY src/ ./src/

# Expor porta
EXPOSE 10000

# Comando para iniciar a aplicação
CMD ["npm", "start"]